# Base
BASE_URL=https://the-internet.herokuapp.com
ENV=dev

# Browser
BROWSER=chromium
HEADLESS=true
SLOW_MO=100
TIMEOUT=30000

# Test
RETRY_COUNT=3
RETRY_DELAY=1000
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true

# AI test agents: the model comes from the agent loop host (claude / opencode /
# codex). For opencode/codex, point them at any OpenAI-compatible endpoint
# (OpenRouter, a local server, or a fleet proxy) via that tool's own config.

# BrowserStack (optional)
BROWSERSTACK_ENABLED=false
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Jira Integration (optional)
JIRA_ENABLED=false
JIRA_BASE=https://your-instance.atlassian.net
JIRA_USER=you@example.com
JIRA_TOKEN=your_api_token
JIRA_DRY_RUN=false
JIRA_TRANSITION_ON_PASS=
JIRA_TRANSITION_ON_FAIL=

# Test Observability
OBSERVABILITY_ENABLED=false

# Debug
DEBUG_MSG=false
