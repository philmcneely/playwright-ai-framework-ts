# Base
BASE_URL=https://the-internet.herokuapp.com
ENV=dev

# Browser
BROWSER=chromium
HEADLESS=true
SLOW_MO=100
TIMEOUT=30000

# Test
RETRY_COUNT=3
RETRY_DELAY=1000
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true

# AI Healing
AI_HEALING_ENABLED=false
OLLAMA_MODEL=llama3.1:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEMPERATURE=0.1
AI_HEALING_CONTEXT_WINDOW=5000
AI_HEALING_CONFIDENCE=0.7

# Credentials (The Internet test site)
USER_PM_USERNAME=tomsmith
USER_PM_PASSWORD=SuperSecretPassword!

# BrowserStack (optional)
BROWSERSTACK_ENABLED=false
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Debug
DEBUG_MSG=false
