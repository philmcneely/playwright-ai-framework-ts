# Base
BASE_URL=https://the-internet.herokuapp.com
ENV=dev

# Browser
BROWSER=chromium
HEADLESS=true
SLOW_MO=100
TIMEOUT=30000

# Test
# Retries / workers (read by playwright.config.ts; defaults: 0 retries, Playwright's worker count)
PW_RETRIES=0
# PW_WORKERS=4

# AI test agents: the model comes from the agent loop host (claude / opencode /
# codex). For opencode/codex, point them at any OpenAI-compatible endpoint
# (OpenRouter or a local/self-hosted server) via that tool's own config.

# Locator healing (npm run heal) goes through a heal service; the model is configured in the service, never here.
# HEAL_SERVICE_URL=http://localhost:8765
# HEAL_SERVICE_TOKEN=
# HEAL_VISION=off            # off | auto | on (one masked viewport screenshot)
# HEAL_MASK=                 # extra selectors to mask in that screenshot (one per line or separated by ;;)
# HEAL_FINGERPRINTS=on       # record what each locator hit on a clean green run (.heal/, git-ignored)
# See docs/HEAL.md for every setting.

# BrowserStack (optional)
BROWSERSTACK_ENABLED=false
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Jira Integration (optional)
JIRA_ENABLED=false
JIRA_BASE=https://your-instance.atlassian.net
JIRA_USER=you@example.com
JIRA_TOKEN=your_api_token
JIRA_DRY_RUN=false
JIRA_TRANSITION_ON_PASS=
JIRA_TRANSITION_ON_FAIL=

# Test Observability
OBSERVABILITY_ENABLED=false

# Debug
DEBUG_MSG=false
